# --- Server ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Public URL of the frontend. CORS is locked to this origin.
# (AI Studio injects this at runtime with the Cloud Run service URL.)
APP_URL="http://localhost:3000"

# --- Database (matches docker-compose.yml) ---
DATABASE_URL="postgresql://pathora:pathora@localhost:5432/pathora"

# --- Secrets: generate each with `openssl rand -base64 48` ---
JWT_SECRET="replace-me-with-at-least-32-random-characters"
COOKIE_SECRET="replace-me-with-at-least-32-random-characters"
# Must be a base64-encoded 32-byte key: `openssl rand -base64 32`
FIELD_ENCRYPTION_KEY="replace-me-base64-32-bytes"

# --- Exports ---
# Generated CSV files are written here (local disk). Use object storage in production.
EXPORT_DIR=.data/exports

# --- Email (team invitations) ---
# Optional. Without it, no email is sent and the person who invites shares the link themselves.
# SMTP_URL="smtps://user:password@smtp.example.com:465"
# MAIL_FROM="Pathora <no-reply@your-domain.example>"

# --- Messaging (Phase 7). 'mock' needs no credentials. ---
MESSAGING_PROVIDER=mock
# AT_USERNAME=
# AT_API_KEY=
# AT_SENDER_ID=
# AT_BASE_URL=https://api.sandbox.africastalking.com   # sandbox; leave unset for production
# Shared secret for delivery-receipt / inbound-reply callbacks. Configure the provider's callback URLs as
#   https://<your-host>/api/webhooks/messaging/delivery?secret=<this value>
#   https://<your-host>/api/webhooks/messaging/inbound?secret=<this value>
# MESSAGING_WEBHOOK_SECRET="generate with: openssl rand -base64 32"

# --- Optional: server-side Gemini (Phase 9) ---
# GEMINI_API_KEY="MY_GEMINI_API_KEY"
